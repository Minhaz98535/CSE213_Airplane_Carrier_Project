<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sohan.ViewAssignedAircraftController">

    <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

        <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="My Assigned Aircraft" />

        <Label fx:id="messageLabel" style="-fx-text-fill: #555555;" text="Select an aircraft to view its information." />

        <TableView fx:id="aircraftTable" prefHeight="220.0" VBox.vgrow="ALWAYS">

            <columns>
                <TableColumn fx:id="aircraftIdColumn" prefWidth="120.0" text="Aircraft ID" />

                <TableColumn fx:id="modelColumn" prefWidth="160.0" text="Model" />

                <TableColumn fx:id="statusColumn" prefWidth="130.0" text="Status" />

                <TableColumn fx:id="flightColumn" prefWidth="160.0" text="Assigned Flight" />
            </columns>
        </TableView>

        <Label fx:id="AircraftDetails" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Aircraft Details" />

        <VBox spacing="8.0">
            <HBox spacing="10.0">
                <Label fx:id="AircraftID" text="Aircraft ID:" />
                <Label fx:id="aircraftIdLabel" text="-" />
            </HBox>

            <HBox spacing="10.0">
                <Label fx:id="ModelID" text="Model:" />
                <Label fx:id="aircraftModelLabel" text="-" />
            </HBox>

            <HBox spacing="10.0">
                <Label fx:id="StatusID" text="Status:" />
                <Label fx:id="aircraftStatusLabel" text="-" />
            </HBox>

            <HBox spacing="10.0">
                <Label fx:id="AssignedFlightID" text="Assigned Flight:" />
                <Label fx:id="assignedFlightLabel" text="-" />
            </HBox>
        </VBox>

        <Button onAction="#handleRefresh" prefWidth="100.0" text="Refresh" />

    </VBox>

</AnchorPane>
