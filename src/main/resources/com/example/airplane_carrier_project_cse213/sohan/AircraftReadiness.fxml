<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sohan.AircraftReadinessController">
    <VBox prefHeight="500" prefWidth="450" spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

        <Label text="Aircraft Readiness" />

        <ComboBox fx:id="aircraftIdComboBox" promptText="Select Aircraft" />

        <ComboBox fx:id="inspectionIdComboBox" promptText="Select Inspection ID" />

        <ComboBox fx:id="repairIdComboBox" promptText="Select Repair ID" />

        <ComboBox fx:id="readinessStatusComboBox" promptText="Select Readiness Status" />

        <TextArea fx:id="remarksArea" promptText="Verification Remarks" />

        <DatePicker fx:id="verificationDatePicker" promptText="Verification Date" />

        <Button onAction="#verifyAircraftButton" text="Verify Aircraft" />
        <Button onAction="#clearButton" text="Clear" />

    </VBox>
</AnchorPane>
