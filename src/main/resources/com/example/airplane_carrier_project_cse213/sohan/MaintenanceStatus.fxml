<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sohan.MaintenanceStatusController">
    <VBox prefHeight="400" prefWidth="450" spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

        <Label text="Maintenance Status Update" />

        <ComboBox fx:id="aircraftIdComboBox" promptText="Select Aircraft" />

        <TextField fx:id="previousStatusField" editable="false" promptText="Previous Status" />

        <ComboBox fx:id="newStatusComboBox" promptText="Select New Status" />

        <TextArea fx:id="remarksArea" promptText="Update Remarks" />

        <Button onAction="#UpdateStatusButton" text="Update Status" />
        <Button onAction="#ClearButton" text="Clear" />

    </VBox>





</AnchorPane>
