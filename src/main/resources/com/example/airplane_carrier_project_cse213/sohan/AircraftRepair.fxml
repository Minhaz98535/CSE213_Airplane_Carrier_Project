<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/27.0.1.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sohan.AircraftrepairController">

    <VBox prefHeight="550" prefWidth="500" spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

        <Label text="Aircraft Repair" />

        <ComboBox fx:id="issueIdComboBox" promptText="Select Issue ID" />

        <ComboBox fx:id="aircraftIdComboBox" promptText="Select Aircraft ID" />

        <TextArea fx:id="requiredPartsArea" promptText="Required Parts" />

        <TextArea fx:id="repairDetailsArea" promptText="Repair Details" />

        <TextArea fx:id="observationsArea" promptText="Observations" />

        <DatePicker fx:id="repairDatePicker" promptText="Repair Date" />

        <Button onAction="#saverepairButton" text="Save Repair" />
        <Button onAction="#clearButton" text="Clear" />

    </VBox>






</AnchorPane>
